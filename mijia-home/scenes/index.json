        "无线按键/场景面板/开关无线键"
      ],
      "trigger": "按某个键",
      "effect": "家庭模式写成对应模式（在家/离家/全屋睡眠/起床/访客）",
      "file": "home-mode-switch.json"
    },
    {
      "id": "home-cascade",
      "name": "全屋带区域（离家、全屋睡眠）",
