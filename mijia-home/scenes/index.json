{
  "schemaVersion": 2,
  "note": "每个模板的完整场景卡片（设备条件、触发、效果、调试技术）在 file 指向的文件的 card 字段里",
  "templates": [
    {
      "id": "dual-control",
      "name": "双控",
      "category": "设备调试",
      "areas": [
        "卧室",
        "过道",
        "任意区域"
      ],
      "builder": "build_dual_control_rule",
      "needs": [
        "开关无线键",
        "开关（有线）"
      ],
      "trigger": "按副开关的键",
      "effect": "切换主开关那一路的灯",
      "file": "dual-control.json"
    },
    {
      "id": "switch-mode",
      "name": "开关改无线（一次性）",
      "category": "设备调试",
      "areas": [
        "任意区域"
      ],
      "builder": "build_switch_mode_rule",
      "needs": [
        "支持无线模式的智能开关"
      ],
      "trigger": "规则加载时（启用一次）",
      "effect": "把选中的键改成无线，接智能灯的那一路设成通电后上电",
      "file": "switch-mode.json"
    },
    {
      "id": "home-mode-switch",
      "name": "家庭模式切换",
      "category": "家庭状态",
      "areas": [
        "全屋"
      ],
      "builder": "build_mode_switch_rule",
