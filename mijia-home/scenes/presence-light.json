{
  "id": "presence-light",
  "name": "人来灯亮、人走灯灭",
  "category": "区域自动化",
  "areas": [
    "走廊",
    "卫生间",
    "衣帽间",
    "楼梯",
    "储物间"
  ],
  "builder": "build_presence_light_rule",
  "needs": [
    {
      "role": "人在/人体传感器",
      "type": "人在传感器/人体传感器",
      "count": "1+"
    },
    {
      "role": "灯",
      "type": "灯/开关",
      "count": "1+"
    },
    {
      "role": "照度",
      "type": "带照度的传感器",
      "count": "0+",
      "note": "可选"
    }
  ],
  "params": {
    "hold_off_ms": "持续无人多久关灯，默认 120000（2 分钟）",
    "lux.below": "照度低于多少才开，推荐 80~100",
    "skip_modes": "这些模式下不开灯，默认 离家"
  },
  "logic": "任一传感器有人 → 不在跳过模式 → 照度够暗 → 灯关着才开；每个传感器各自持续无人 → 全部无人并复核 → 灯开着才关。",
  "notes": [
    "亮度色温交给灯光跟随模式",
    "多盏灯共用一个照度传感器时，灯会把照度顶高导致后面的灯不亮；这种区域去掉照度条件",
    "毫米波静坐可能有盲区，可加一个 PIR 补盲"
  ],
  "card": {
    "scope": "room",
    "roomWords": [
      "走廊",
      "过道",
      "卫",
      "浴",
      "洗手间",
      "衣帽间",
      "楼梯",
      "储物"
    ],
    "match": [
      {
        "role": "人体/人在传感器",
        "cats": [
          "人在传感器",
          "人体传感器"
        ],
        "where": "本房间",
        "count": 1
      },
      {
        "role": "灯",
        "cats": [
          "灯",
          "开关"
        ],
        "where": "本房间",
        "count": 1
      },
      {
        "role": "光照传感器",
        "cats": [
          "光照传感器"
        ],
        "where": "本房间",
        "count": 1,
        "optional": true
      }
    ],
    "conditions": {
      "required": [
        "本区域：人体/人在传感器 1+",
        "本区域：灯 1+"
      ],
      "optional": [
        "本区域：照度传感器"
      ]
    },
    "trigger": "有人且不在离家模式（可加：照度够暗）",
    "effect": "灯关着就开；亮度色温交给灯光跟随",
    "effectTunable": "按灯光跟随的当前模式",
    "effectPlain": "开",
    "autoOff": "每个传感器都持续无人（默认 2 分钟）并复核→关灯",
    "debug": [
      "传感器「有人/无人」用 include",
      "多传感器关灯要复核此刻仍无人（logicAnd 是锁存）",
      "灯会把照度顶高，多盏灯共用照度传感器时去掉照度条件"
    ]
  }
