{
  "id": "arrive-home",
  "name": "回家",
  "category": "区域自动化",
  "areas": [
    "玄关"
  ],
  "builder": "build_arrive_home_rule",
  "needs": [
    {
      "role": "开门信号",
      "type": "智能门锁开门事件 / 门窗传感器",
      "count": "1"
    },
    {
      "role": "回家要开的设备",
      "type": "灯/空调/窗帘等",
      "count": "1+"
    }
  ],
  "params": {
    "entry": "门锁开门事件 eiid 或门窗传感器打开属性，按 spec 核对",
    "writes": "回家动作"
  },
  "logic": "开门且当前是离家 → 家庭模式改为在家 → 执行回家动作；在家时开门不触发。",
  "notes": [
    "门锁开门事件的 eiid 和参数因型号而异，必须用 spec 或已有备份核对"
  ],
  "card": {
    "scope": "room",
    "roomWords": [
      "玄关",
      "门厅",
      "入户"
    ],
    "match": [
      {
        "role": "入户门锁或门窗传感器",
        "cats": [
          "门锁",
          "门窗传感器"
        ],
        "where": "本房间",
        "count": 1
      },
      {
        "role": "玄关/客厅灯",
        "cats": [
          "灯",
          "开关"
        ],
        "where": "本房间",
        "count": 1
      }
    ],
    "conditions": {
      "required": [
        "玄关：智能门锁或门窗传感器 1",
        "玄关/客厅：灯 1+"
      ],
      "optional": [
        "客厅：窗帘、空调"
      ]
    },
    "trigger": "开门，且家庭模式=离家",
    "effect": "家庭模式改成「在家」→ 开玄关灯等回家设备",
    "effectTunable": "温馨：40%、3000K",
    "effectPlain": "开玄关灯；客厅开重点照明和氛围灯",
    "autoOff": null,
    "debug": [
      "门锁开门事件 eiid 和参数因型号而异，照抄网关已有规则或查 spec",
      "不为测试去开真门锁，可先用门窗传感器验证",
      "在家时开门不触发，避免家人进出反复执行"
    ]
  }
}
