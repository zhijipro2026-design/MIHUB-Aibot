  "card": {
    "scope": "home",
    "askFirst": true,
    "roomWords": [],
    "match": [
      {
        "role": "小爱音箱",
        "cats": [
          "音箱"
        ],
        "where": "全屋",
        "count": 1
      }
    ],
    "conditions": {
      "required": [
        "全屋：小爱音箱 1"
      ],
      "optional": [
        "门窗传感器、空调"
      ]
    },
    "trigger": "家庭模式变成离家或全屋睡眠",
    "effect": "小爱提醒窗没关、空调还开着这类事；都正常就不说话",
    "effectTunable": null,
    "effectPlain": null,
    "autoOff": null,
    "debug": [
      "先问客户要不要",
      "睡眠时音量调小",
      "先用一条固定文字测试能不能出声，再加检查项"
    ]
  }
}