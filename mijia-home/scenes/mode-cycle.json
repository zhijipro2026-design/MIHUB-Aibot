{
  "id": "mode-cycle",
  "name": "一个键轮流切模式",
  "category": "区域模式",
  "areas": [
    "客厅",
    "卧室",
    "任意区域"
  ],
  "builder": "build_mode_cycle_rule",
  "needs": [
    {
      "role": "轮换键",
      "type": "无线键",
      "count": "1"
    },
    {
      "role": "关键（可选）",
      "type": "无线键",
      "count": "0-1"
    },
    {
      "role": "这个区域的灯",
      "type": "灯/开关",
      "count": "2+"
    }
  ],
  "params": {
    "keys": "轮换键",
    "lights": "这个区域的灯",
    "modes": "省略=自动挑开的灯不同的模式",
    "off_keys": "可选关键"
  },
  "logic": "按键 → 看「<区域>模式」现在是哪个 → 切到下一个；不在列表里的一律切到第一个。",
  "notes": [
    "不另加计数器，区域模式变量就记着现在是哪个",
    "跳过开的灯完全一样的模式，免得按了没变化"
  ],
  "card": {
    "scope": "room",
    "roomWords": [],
    "match": [
      {
        "role": "空着的无线键",
        "cats": [
          "无线按键",
          "开关"
        ],
        "where": "本房间",
        "count": 1
      },
      {
        "role": "灯",
        "cats": [
          "灯",
          "开关"
        ],
        "where": "本房间",
        "count": 2
      }
    ],
    "conditions": {
      "required": [
        "一个空着的无线键",
        "这个区域 2 盏以上的灯"
      ],
      "optional": [
        "第二个键当关键",
        "调光灯"
      ]
    },
    "trigger": "按轮换键",
    "effect": "每按一次换一个模式：明亮 → 休闲 → 温馨 → 放松 → 休憩 → 再回到明亮",
    "effectTunable": null,
    "effectPlain": null,
    "autoOff": null,
    "debug": [
      "先按一次看是不是从第一个开始",
      "连续按，看每次开的灯都不一样",
      "按关键全关后，再按轮换键从第一个开始"
    ]
  }
}