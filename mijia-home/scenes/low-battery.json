  "card": {
    "scope": "home",
    "roomWords": [],
    "match": [
      {
        "role": "电池类传感器",
        "cats": [
          "门窗传感器",
          "人体传感器",
          "人在传感器",
          "无线按键",
          "温湿度传感器"
        ],
        "where": "全屋",
        "count": 1
      }
    ],
    "conditions": {
      "required": [
        "电池类传感器"
      ],
      "optional": [
        "小爱音箱"
      ]
    },
    "trigger": "传感器电量低于 20%",
    "effect": "哪个传感器快没电了，提前告诉你换电池，免得自动化突然不灵",
    "effectTunable": null,
    "effectPlain": null,
    "autoOff": null,
    "debug": [
      "电量属性读一次，确认是 0–100 的数"
    ]
  }
